# SPDX-License-Identifier: GPL-3.0-or-later
# On-demand only. No GPU writes, tuning or recovery flashing during boot.
service unica_gpu /system/bin/unica-gpu
    user root
    group system cache
    capabilities SYS_RAWIO
    disabled
    oneshot

on post-fs-data
    mkdir /data/misc/unica_gpu 0777 system system
    chmod 0777 /data/misc/unica_gpu
    mkdir /data/misc/unica_gpu/requests 0777 system system
    chmod 0777 /data/misc/unica_gpu/requests
    mkdir /data/misc/unica_gpu/responses 0777 system system
    chmod 0777 /data/misc/unica_gpu/responses
    mkdir /data/misc/unica_gpu/archives 0777 root root
    chmod 0777 /data/misc/unica_gpu/archives
    mkdir /cache/unica-gpu 0777 system system
    chmod 0777 /cache/unica-gpu
    restorecon /dev/block/sda28
    restorecon /dev/block/sde20

on property:sys.unica.gpu.request=*
    start unica_gpu
