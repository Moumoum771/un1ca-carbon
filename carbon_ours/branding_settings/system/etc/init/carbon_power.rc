#
# UN1CA Carbon IX - Performance Engine Trigger Service
#

on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/carbon_power_engine boot

on property:persist.carbon.power_mode=light
    exec u:r:su:s0 root root -- /system/bin/carbon_power_engine light

on property:persist.carbon.power_mode=normal
    exec u:r:su:s0 root root -- /system/bin/carbon_power_engine normal

on property:persist.carbon.power_mode=performance
    exec u:r:su:s0 root root -- /system/bin/carbon_power_engine performance
