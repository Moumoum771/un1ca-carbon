service rezoss_bootanim /system/bin/bootanimation
    class core
    user graphics
    group graphics system
    disabled
    oneshot

on post-fs-data
    exec_background -- /system/bin/sh /system/etc/unica/rezoss_bootanimation.sh --apply

on property:persist.sys.unica.bootanim=*
    exec_background -- /system/bin/sh /system/etc/unica/rezoss_bootanimation.sh --apply

